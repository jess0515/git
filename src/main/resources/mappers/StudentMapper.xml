<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="StudentMapper">
<select id="queryStudentById" resultType="entity.Student">
    select id,name,gender,age,classid,phone from student where id = #{value} limit 1
</select>
<select id="queryStudentByName" resultType="entity.Student">
    select id,name,gender,age,classid,phone from student where name = #{value} limit 1
</select>
<select id="queryByClassId" resultType="entity.Student">
    select id,name,gender,age,classid,phone from student where classid = #{value} order by id
</select>
<insert id="AddStudent" useGeneratedKeys="true" keyProperty="id">
    insert into student(name,age,gender,classid,phone) values(#{name},#{age},#{gender},#{classid},#{phone})
</insert>
<delete id="DeleteStudent">
    delete from student where id = #{value}
</delete>
<update id="UpdateStudent">
    update student set name=#{name},age=#{age},gender=#{gender},classid=#{classid},phone=#{phone} where id=#{id}
</update>
</mapper>
