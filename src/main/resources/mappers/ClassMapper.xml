<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ClassMapper">
<select id="getClassById" resultType="entity.Classes">
    select classid,classname from `class` where classid=#{value} limit 1
</select>
<select id="queryClassByName" resultType="entity.Classes">
    select classid,classname from `class` where classname=#{value} limit 1
</select>
<select id="queryAllClasses" resultType="entity.Classes">
    select classid,classname from `class` order by classid
</select>
<insert id="Addclass">
    insert into `class`(classname) values(#{classname})
</insert>
<delete id="Deleteclass">
    delete from `class` where classid=#{value}
</delete>
<update id="Updateclass">
    update `class` set classname=#{classname} where classid=#{classid}
</update>
</mapper>
